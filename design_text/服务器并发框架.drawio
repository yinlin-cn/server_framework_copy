        </mxCell>
        <mxCell id="STjBpZyOdN-5esgf6YGE-64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="其他模块完成工作后将结构体中的function，也就是业务工作逻辑里的on_event函数推入任务序列中等待线程池调用并唤醒阻塞队列里的任务" vertex="1">
          <mxGeometry height="120" width="215" x="695.5" y="3869.5" as="geometry" />
        </mxCell>
        <mxCell id="STjBpZyOdN-5esgf6YGE-65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="线程池的工作线程从任务序列中取出任务后将任务序列中的连接信息设置为白板，然后执行任务结构体中的function，无论是否完成任务在线程归还时要将白板清空" vertex="1">
          <mxGeometry height="115" width="270" x="628" y="3504.5" as="geometry" />
        </mxCell>
